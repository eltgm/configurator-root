{
  "name": "configurator-web",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "allowScripts": {
    "msw@2.15.0": true
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "fast-uri": "3.1.6"
  },
  "scripts": {
    "api:generate": "openapi-ts",
    "api:check": "node scripts/check-generated-api.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update-snapshots",
    "test:visual:container": "playwright test --config=playwright.visual.config.ts",
    "test:delivery": "playwright test --config=playwright.delivery.config.ts",
    "check": "npm run api:check && npm run format:check && npm run lint && npm run lint:styles && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.103.2",
    "@xyflow/react": "12.12.0",
    "d3-force": "3.0.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
